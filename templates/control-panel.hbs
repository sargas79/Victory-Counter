{{!-- GM control panel. Rendered inside a standard ApplicationV2 window frame.
      An ApplicationV2 template part must resolve to exactly one root element,
      so everything below is wrapped in a single container.

      The track list is a CSS Grid (`auto-fill` + `minmax`), so widening the
      window turns one column of cards into two or three instead of growing a
      taller scroll area.

      Mode-specific fields are shown or hidden purely by the `data-mode`
      attribute on the enclosing `[data-mode-scope]`, which the mode select
      rewrites on change. The scope sits on the fieldset / track card rather
      than on an inner wrapper so that it encloses the select as well as the
      fields it governs — `#bindModeSwitches` finds it with `closest()`, which
      only walks ancestors.

      Hidden fields stay in the DOM on purpose: the form readers still find
      them, so switching mode twice never loses what was typed in between. --}}

<div class="pvc-panel-body">

<fieldset class="pvc-panel-config" data-mode-scope data-mode="progress">
  <legend>{{localize "PVC.Panel.AddTrackLegend"}}</legend>

  {{#if atMax}}
  <p class="notes"><i class="fa-solid fa-triangle-exclamation" aria-hidden="true"></i>
    {{localize "PVC.Panel.MaxTracksReached" max=limits.MAX_TRACKS}}</p>
  {{else}}

  <div class="pvc-field-row">
    <div class="form-group">
      <label for="pvc-new-title">{{localize "PVC.Panel.TrackName"}}</label>
      <div class="form-fields">
        <input type="text" id="pvc-new-title" name="new-title"
               maxlength="{{limits.MAX_TITLE_LENGTH}}"
               placeholder="{{localize 'PVC.DefaultTitle'}}">
      </div>
    </div>

    <div class="form-group pvc-field-narrow">
      <label for="pvc-new-mode">{{localize "PVC.Panel.Mode"}}</label>
      <div class="form-fields">
        <select id="pvc-new-mode" name="new-mode" data-mode-select
                data-tooltip="{{localize 'PVC.Panel.ModeHint'}}">
          {{#each modes}}
          <option value="{{value}}">{{label}}</option>
          {{/each}}
        </select>
      </div>
    </div>
  </div>

  <p class="hint">{{localize "PVC.Panel.TrackNameHint"}}</p>

  <div class="pvc-field-row" data-mode-group="progress">
    <div class="form-group pvc-field-narrow">
      <label for="pvc-new-target">{{localize "PVC.Panel.Target"}}</label>
      <div class="form-fields">
        <input type="number" id="pvc-new-target" name="new-target"
               value="6" min="{{limits.MIN_TARGET}}" max="{{limits.MAX_TARGET}}" step="1"
               data-tooltip="{{localize 'PVC.Panel.TargetHint'}}">
      </div>
    </div>

    <div class="form-group pvc-field-narrow">
      <label for="pvc-new-type">{{localize "PVC.Panel.Type"}}</label>
      <div class="form-fields">
        <select id="pvc-new-type" name="new-type"
                data-tooltip="{{localize 'PVC.Panel.TypeHint'}}">
          {{#each types}}
          <option value="{{value}}">{{label}}</option>
          {{/each}}
        </select>
      </div>
    </div>
  </div>

  <div data-mode-group="threshold">
    <div class="pvc-field-row">
      <div class="form-group pvc-field-narrow">
        <label for="pvc-new-start">{{localize "PVC.Panel.Start"}}</label>
        <div class="form-fields">
          <input type="number" id="pvc-new-start" name="new-start"
                 value="{{defaults.start}}"
                 min="{{limits.MIN_VALUE}}" max="{{limits.MAX_VALUE}}" step="1"
                 data-tooltip="{{localize 'PVC.Panel.StartHint'}}">
        </div>
      </div>

      <div class="form-group pvc-field-narrow">
        <label for="pvc-new-min">{{localize "PVC.Panel.Min"}}</label>
        <div class="form-fields">
          <input type="number" id="pvc-new-min" name="new-min"
                 value="{{defaults.min}}"
                 min="{{limits.MIN_VALUE}}" max="{{limits.MAX_VALUE}}" step="1"
                 data-tooltip="{{localize 'PVC.Panel.MinHint'}}">
        </div>
      </div>

      <div class="form-group pvc-field-narrow">
        <label for="pvc-new-max">{{localize "PVC.Panel.Max"}}</label>
        <div class="form-fields">
          <input type="number" id="pvc-new-max" name="new-max"
                 value="{{defaults.max}}"
                 min="{{limits.MIN_VALUE}}" max="{{limits.MAX_VALUE}}" step="1"
                 data-tooltip="{{localize 'PVC.Panel.MaxHint'}}">
        </div>
      </div>
    </div>

    <p class="hint">{{localize "PVC.Panel.ThresholdCreateHint"}}</p>

    <div class="form-group">
      <label for="pvc-new-reveal">{{localize "PVC.Panel.RevealLadder"}}</label>
      <div class="form-fields">
        <input type="checkbox" id="pvc-new-reveal" name="new-revealLadder">
      </div>
      <p class="hint">{{localize "PVC.Panel.RevealLadderHint"}}</p>
    </div>
  </div>

  <div class="form-group">
    <label for="pvc-new-visible">{{localize "PVC.Panel.VisibleToPlayers"}}</label>
    <div class="form-fields">
      <input type="checkbox" id="pvc-new-visible" name="new-visibleToPlayers" checked>
    </div>
    <p class="hint">{{localize "PVC.Panel.VisibleToPlayersHint"}}</p>
  </div>

  <footer class="pvc-panel-actions">
    <button type="button" class="pvc-primary" data-action="addTrack">
      <i class="fa-solid fa-flag-checkered" aria-hidden="true"></i>
      {{localize "PVC.Panel.AddTrack"}}
    </button>
  </footer>
  {{/if}}
</fieldset>

<fieldset class="pvc-panel-tracks">
  <legend>{{localize "PVC.Panel.TracksLegend"}}</legend>

  {{#unless tracks.length}}
  <p class="notes">{{localize "PVC.Panel.NoTracks"}}</p>
  {{/unless}}

  <div class="pvc-track-grid">
  {{#each tracks}}
  {{!-- Polarity and completion styling apply to progress tracks only. `type`
        survives a switch to threshold mode, so a track that used to be Negative
        would otherwise keep its red numerals while its band tone says the
        opposite; and a threshold track never completes. --}}
  <div class="pvc-track-card{{#if threshold}} pvc-threshold pvc-tone-{{tone}}{{else}}{{#if negative}} pvc-negative{{/if}}{{#if complete}} pvc-resolved{{/if}}{{/if}}"
       data-id="{{id}}" data-mode-scope data-mode="{{mode}}">

    <div class="pvc-panel-status-line">
      {{#if threshold}}
      <span class="pvc-band-badge pvc-tone-{{tone}}" data-tooltip="{{bandDescription}}">
        <i class="fa-solid {{#if (eq tone 'positive')}}fa-arrow-up{{else if (eq tone 'negative')}}fa-arrow-down{{else}}fa-equals{{/if}}"
           aria-hidden="true"></i>
        {{bandLabel}}
      </span>
      {{else}}
      <span class="pvc-badge pvc-badge-{{status}}">{{statusLabel}}</span>
      <span class="pvc-type-badge" data-tooltip="{{typeTooltip}}">
        <i class="fa-solid {{#if negative}}fa-arrow-down{{else}}fa-arrow-up{{/if}}" aria-hidden="true"></i>
        {{typeLabel}}
      </span>
      {{/if}}
      {{#unless visibleToPlayers}}
      <i class="fa-solid fa-eye-slash" data-tooltip="{{localize 'PVC.Panel.HiddenNotice'}}"
         aria-label="{{localize 'PVC.Panel.HiddenNotice'}}"></i>
      {{/unless}}
      <div class="pvc-row-move">
        <button type="button" data-action="moveTrack" data-id="{{id}}" data-direction="-1"
                data-tooltip="{{localize 'PVC.Panel.MoveUp'}}"
                aria-label="{{localize 'PVC.Panel.MoveUp'}}">
          <i class="fa-solid fa-chevron-up" aria-hidden="true"></i>
        </button>
        <button type="button" data-action="moveTrack" data-id="{{id}}" data-direction="1"
                data-tooltip="{{localize 'PVC.Panel.MoveDown'}}"
                aria-label="{{localize 'PVC.Panel.MoveDown'}}">
          <i class="fa-solid fa-chevron-down" aria-hidden="true"></i>
        </button>
      </div>
    </div>

    {{#if threshold}}
    {{> "modules/victory-counter/templates/threshold-ladder.hbs"}}
    {{else if ../rings}}
    <div class="pvc-ring-wrap pvc-ring-compact">
      {{> "modules/victory-counter/templates/progress-ring.hbs" ring=../ring}}
    </div>
    {{/if}}

    <div class="form-group">
      <label for="pvc-title-{{id}}">{{localize "PVC.Panel.TrackName"}}</label>
      <div class="form-fields">
        <input type="text" id="pvc-title-{{id}}" name="title-{{id}}" value="{{title}}"
               maxlength="{{../limits.MAX_TITLE_LENGTH}}"
               placeholder="{{localize 'PVC.DefaultTitle'}}">
      </div>
    </div>

    <div class="form-group pvc-field-narrow">
      <label for="pvc-mode-{{id}}">{{localize "PVC.Panel.Mode"}}</label>
      <div class="form-fields">
        <select id="pvc-mode-{{id}}" name="mode-{{id}}" data-mode-select
                data-tooltip="{{localize 'PVC.Panel.ModeHint'}}">
          {{#each ../modes}}
          <option value="{{value}}" {{#if (eq value ../mode)}}selected{{/if}}>{{label}}</option>
          {{/each}}
        </select>
      </div>
    </div>

    <div class="pvc-field-row" data-mode-group="progress">
      <div class="form-group pvc-field-narrow">
        <label for="pvc-target-{{id}}">{{localize "PVC.Panel.Target"}}</label>
        <div class="form-fields">
          <input type="number" id="pvc-target-{{id}}" name="target-{{id}}" value="{{target}}"
                 min="{{../limits.MIN_TARGET}}" max="{{../limits.MAX_TARGET}}" step="1"
                 data-tooltip="{{localize 'PVC.Panel.TargetHint'}}">
        </div>
      </div>

      <div class="form-group pvc-field-narrow">
        <label for="pvc-type-{{id}}">{{localize "PVC.Panel.Type"}}</label>
        <div class="form-fields">
          <select id="pvc-type-{{id}}" name="type-{{id}}"
                  data-tooltip="{{localize 'PVC.Panel.TypeHint'}}">
            {{#each ../types}}
            <option value="{{value}}" {{#if (eq value ../type)}}selected{{/if}}>{{label}}</option>
            {{/each}}
          </select>
        </div>
      </div>
    </div>

    <div data-mode-group="threshold">
      <div class="pvc-field-row">
        <div class="form-group pvc-field-narrow">
          <label for="pvc-start-{{id}}">{{localize "PVC.Panel.Start"}}</label>
          <div class="form-fields">
            <input type="number" id="pvc-start-{{id}}" name="start-{{id}}" value="{{start}}"
                   min="{{../limits.MIN_VALUE}}" max="{{../limits.MAX_VALUE}}" step="1"
                   data-tooltip="{{localize 'PVC.Panel.StartHint'}}">
          </div>
        </div>

        <div class="form-group pvc-field-narrow">
          <label for="pvc-min-{{id}}">{{localize "PVC.Panel.Min"}}</label>
          <div class="form-fields">
            <input type="number" id="pvc-min-{{id}}" name="min-{{id}}" value="{{min}}"
                   min="{{../limits.MIN_VALUE}}" max="{{../limits.MAX_VALUE}}" step="1"
                   data-tooltip="{{localize 'PVC.Panel.MinHint'}}">
          </div>
        </div>

        <div class="form-group pvc-field-narrow">
          <label for="pvc-max-{{id}}">{{localize "PVC.Panel.Max"}}</label>
          <div class="form-fields">
            <input type="number" id="pvc-max-{{id}}" name="max-{{id}}" value="{{max}}"
                   min="{{../limits.MIN_VALUE}}" max="{{../limits.MAX_VALUE}}" step="1"
                   data-tooltip="{{localize 'PVC.Panel.MaxHint'}}">
          </div>
        </div>
      </div>

      <div class="form-group">
        <label for="pvc-reveal-{{id}}">{{localize "PVC.Panel.RevealLadder"}}</label>
        <div class="form-fields">
          <input type="checkbox" id="pvc-reveal-{{id}}" name="revealLadder-{{id}}"
                 {{checked revealLadder}}
                 data-tooltip="{{localize 'PVC.Panel.RevealLadderHint'}}">
        </div>
      </div>

      <div class="pvc-ladder-summary">
        <span class="notes">
          {{#if thresholdCount}}
          {{localize "PVC.Panel.LadderSummary" count=thresholdCount}}
          {{else}}
          {{localize "PVC.Panel.LadderEmpty"}}
          {{/if}}
        </span>
        <button type="button" data-action="editThresholds" data-id="{{id}}"
                data-tooltip="{{localize 'PVC.Panel.EditThresholdsHint'}}">
          <i class="fa-solid fa-layer-group" aria-hidden="true"></i>
          {{localize "PVC.Panel.EditThresholds"}}
        </button>
      </div>

      <div class="form-group">
        <label for="pvc-band-announce-{{id}}">{{localize "PVC.Panel.AnnounceBands"}}</label>
        <div class="form-fields">
          <button type="button" id="pvc-band-announce-{{id}}"
                  data-action="toggleThresholdAnnounce" data-id="{{id}}"
                  data-tooltip="{{localize 'PVC.Panel.AnnounceBandsHint'}}"
                  aria-pressed="{{#if announcingThresholds}}true{{else}}false{{/if}}">
            <i class="fa-solid {{#if announcingThresholds}}fa-bell{{else}}fa-bell-slash{{/if}}"
               aria-hidden="true"></i>
            {{#if announcingThresholds}}{{localize "PVC.Panel.BandsAnnouncing"}}{{else}}{{localize "PVC.Panel.BandsSilent"}}{{/if}}
          </button>
        </div>
      </div>
    </div>


    <div class="form-group">
      <label for="pvc-visible-{{id}}">{{localize "PVC.Panel.VisibleToPlayers"}}</label>
      <div class="form-fields">
        <input type="checkbox" id="pvc-visible-{{id}}" name="visibleToPlayers-{{id}}"
               {{checked visibleToPlayers}}>
      </div>
    </div>

    <div class="form-group">
      <label for="pvc-announce-{{id}}">{{localize "PVC.Panel.PostToChat"}}</label>
      <div class="form-fields">
        <span class="pvc-flag {{#if announcing}}pvc-flag-on{{else}}pvc-flag-off{{/if}}">
          <i class="fa-solid {{#if announcing}}fa-comment{{else}}fa-comment-slash{{/if}}"
             aria-hidden="true"></i>
          {{#if announcing}}{{localize "PVC.Panel.AnnounceOn"}}{{else}}{{localize "PVC.Panel.AnnounceOff"}}{{/if}}
        </span>
      </div>
    </div>

    <footer class="pvc-panel-actions">
      <button type="button" data-action="applyConfig" data-id="{{id}}">
        <i class="fa-solid fa-floppy-disk" aria-hidden="true"></i>
        {{localize "PVC.Panel.Apply"}}
      </button>
      <button type="button" data-action="toggleVisibility" data-id="{{id}}">
        <i class="fa-solid {{#if visibleToPlayers}}fa-eye{{else}}fa-eye-slash{{/if}}" aria-hidden="true"></i>
        {{localize "PVC.Panel.ToggleVisibility"}}
      </button>
      <button type="button" id="pvc-announce-{{id}}"
              data-action="toggleAnnounce" data-id="{{id}}"
              data-tooltip="{{localize 'PVC.Panel.PostToChatHint'}}"
              aria-pressed="{{#if announcing}}true{{else}}false{{/if}}">
        <i class="fa-solid {{#if announcing}}fa-comment-slash{{else}}fa-comment{{/if}}" aria-hidden="true"></i>
        {{#if announcing}}{{localize "PVC.Panel.StopAnnouncing"}}{{else}}{{localize "PVC.Panel.StartAnnouncing"}}{{/if}}
      </button>
    </footer>

    <div class="pvc-stepper">
      <span class="pvc-stepper-label">{{#if threshold}}{{localize "PVC.Value"}}{{else}}{{localize "PVC.Progress"}}{{/if}}</span>
      <button type="button" data-action="adjustTrack" data-id="{{id}}" data-delta="-1"
              data-tooltip="{{localize 'PVC.Action.DecreaseHint'}}"
              aria-label="{{localize 'PVC.Action.DecreaseHint'}}">
        <i class="fa-solid fa-minus" aria-hidden="true"></i>
      </button>
      <span class="pvc-stepper-value">{{#if threshold}}{{current}}{{else}}{{current}} / {{target}}{{/if}}</span>
      <button type="button" data-action="adjustTrack" data-id="{{id}}" data-delta="1"
              data-tooltip="{{localize 'PVC.Action.IncreaseHint'}}"
              aria-label="{{localize 'PVC.Action.IncreaseHint'}}">
        <i class="fa-solid fa-plus" aria-hidden="true"></i>
      </button>
    </div>

    <footer class="pvc-panel-actions">
      <button type="button" data-action="resetProgress" data-id="{{id}}">
        <i class="fa-solid fa-arrows-rotate" aria-hidden="true"></i>
        {{#if threshold}}{{localize "PVC.Panel.ResetToStart"}}{{else}}{{localize "PVC.Panel.ResetProgress"}}{{/if}}
      </button>
      <button type="button" class="pvc-danger" data-action="removeTrack" data-id="{{id}}">
        <i class="fa-solid fa-circle-stop" aria-hidden="true"></i> {{localize "PVC.Panel.End"}}
      </button>
    </footer>
  </div>
  {{/each}}
  </div>

  <footer class="pvc-panel-actions">
    <button type="button" data-action="undoChange" {{disabled (not canUndo)}}>
      <i class="fa-solid fa-rotate-left" aria-hidden="true"></i> {{localize "PVC.Panel.Undo"}}
    </button>
  </footer>
</fieldset>

</div>
